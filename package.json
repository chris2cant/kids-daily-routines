{
  "name": "kids-daily-routines",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "next build",
    "check": "node scripts/check.mjs",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:types": "supabase gen types typescript --local > src/lib/supabase/database.types.ts",
    "dev": "next dev",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint --format=agent",
    "lint:fix": "oxlint --fix --format=agent",
    "start": "next start",
    "test": "vitest",
    "test:changed": "vitest run --changed --passWithNoTests --reporter=dot",
    "test:e2e": "playwright test",
    "test:run": "vitest run --passWithNoTests --reporter=dot",
    "typecheck": "tsc --noEmit",
    "verify": "pnpm check && pnpm build && pnpm test:e2e"
  },
  "dependencies": {
    "next": "16.3.5",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@playwright/cli": "0.1.19",
    "@playwright/test": "1.63.0",
    "@types/node": "26.5.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "babel-plugin-react-compiler": "1.0.0",
    "oxfmt": "0.68.0",
    "oxlint": "1.83.0",
    "oxlint-tsgolint": "7.0.2001",
    "supabase": "2.117.0",
    "typescript": "7.0.2",
    "typescript-language-server": "6.0.0",
    "vitest": "5.0.0"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@11.23.0"
}
